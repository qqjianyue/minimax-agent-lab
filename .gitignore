.env
.env.*
!.env.template
!*.env.template
secrets/

# 私密配置：绝对不进版本库。
# 项目配置 config.yaml 是要提交的（随 release 走），所以只挡 mask-*.yaml。
mask-config.yaml
mask-*.yaml
deploy/config.local.yaml

# 目标机部署产物（不应进仓库）
releases/
current
previous
deploy-state.json
*.tar.gz

# Logs & local observability stores
*.log
phoenix_data/
langfuse-data/

# 本机运行时数据。
# 审计账本默认写在 cwd 下（audit/ledger.jsonl），本地跑一次服务就会生成。
# 测试已由 tests/integration/conftest.py 把 cwd 挪到 tmp_path 避免污染仓库，
# 这里只是给"手动跑一次服务"留的兜底 —— 运行数据永远不该进版本库。
audit/

