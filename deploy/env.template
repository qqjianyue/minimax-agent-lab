# 目标机非密钥配置模板
#
# install.sh 会把本文件复制为 shared/.env（若尚不存在）。**真实内容不要提交进仓库。**
# 权限要求：chmod 600 shared/.env
#
# ── 重要 ────────────────────────────────────────────────────────────────
# 本文件**不放密钥**。密钥在 deploy/config.yaml 声明的 mask-config.yaml 里，
# 由 app 自行解析加载（systemd 的 EnvironmentFile 只认 KEY=VALUE，喂 YAML
# 会被静默忽略）。两个文件职责分开，避免出现两个互相覆盖的密钥来源。
# ───────────────────────────────────────────────────────────────────────

# --- 模型 ---
MINIMAX_AGENT_LLM__MODEL=MiniMax-M3
MINIMAX_AGENT_LLM__JUDGE_MODEL=MiniMax-M2.5
MINIMAX_AGENT_LLM__BASE_URL=https://api.minimax.cn/v1
MINIMAX_AGENT_LLM__TIMEOUT_S=60
MINIMAX_AGENT_LLM__MAX_RETRIES=2

# --- ML 模型（D1）---
# 嵌入模型根目录。由 infra/models/env 声明、部署时 update.sh 自动同步覆盖
# 本行（sync_component_env），安装期勿手工改。缺失时 SentenceEmbedder 会
# 回退到 HF 仓库名联网加载，L3 检测墙钟（5s）内必然超时。
MODELS_HOME=/data/workspace/minimax-agent/shared/models

# --- 服务 ---
MINIMAX_AGENT_APP__HOST=127.0.0.1
MINIMAX_AGENT_APP__PORT=8080
MINIMAX_AGENT_APP__LOG_LEVEL=INFO
MINIMAX_AGENT_APP__MAX_STEPS=10

# --- 检索 / 间接注入防御（FT-09）---
# 代码里的默认是**关闭**（RetrievalSettings.enabled=False），这里是参考部署
# 显式打开 —— 一条默认关着的防线，等于没有防线。
#
# 打开的代价：每个 /chat 请求会多出「BM25 召回 + 每篇文档一次 RETRIEVAL
# 检测点」，其中检索 judge 是一次 LLM 调用。top_k=2 是延迟与覆盖面的折中
# （实测 top_k=3 会连带召回投毒文档，隔离的篇数变多、judge 调用也变多）。
MINIMAX_AGENT_APP__RETRIEVAL__ENABLED=true
MINIMAX_AGENT_APP__RETRIEVAL__TOP_K=2

# --- 可观测性 ---
# 银行场景默认不把 prompt / response 原文写进 trace
MINIMAX_AGENT_TELEMETRY__CAPTURE_PROMPTS=false
MINIMAX_AGENT_TELEMETRY__PHOENIX_ENDPOINT=http://127.0.0.1:6006
