# spaCy NER 模型配置模板（D2 / B4）
#
# 复制为 env 后按机器修改：cp env.template env
# env 不会进版本库；部署时由 deploy/lib/common.sh 的 ensure_component_env
# 结合实际环境自动生成（已存在的手工 env 不被覆盖）。
# 机器定制请写在部署根 config.yaml（${AGENT_HOME}/config.yaml）的
# components.spacy 下，部署时自动解析覆写本 env —— 不要手工改 env。

# --- 路径 ---
# 应用根目录（shared/venv 位于其下，与 deploy/ 的 AGENT_HOME 一致）
AGENT_HOME=/data/workspace/minimax-agent

# --- 模型 ---
# **B4 起是双语**（manifest.json 的 models 数组才是唯一权威，此处不再列版本）：
#   en_core_web_lg —— 英文 NER
#   zh_core_web_lg —— 中文 NER（B4 关卡 0 实测：中文召回率 33.3% → 100%）
# 中文模型需要 spacy-pkuseg>=1.0.1，由 pyproject 的 ml extra 提供。
# 0.0.33 的二进制 wheel 是 numpy 1.x ABI，在 numpy 2.x 上直接
# ValueError: numpy.dtype size changed —— 装错版本会得到"装上了但 load 失败"。

# --- 网络 ---
# 目标机 PyPI 受限时启用镜像（如 https://pypi.tuna.tsinghua.edu.cn/simple）。
# 留空 = 直连官方 PyPI
PIP_INDEX_URL=

# --- 模型 wheel 来源（按语言分别覆盖） ---
# 留空 = 从 GitHub Releases 下载（目标机 GitHub 不可达时会失败）。
# 部署脚本生成 env 时，若持久目录 ${AGENT_HOME%/*}/tmp 下存在本地 wheel
# （如 /data/workspace/tmp/zh_core_web_lg-3.8.0-py3-none-any.whl），会
# 自动指向该文件 —— 本地 wheel 放持久目录，重启不丢（/tmp 会被系统清空）。
# 实测：目标机直连 GitHub 约 100KB/s（575MB 要 1.5 小时），走代理 + 并行分块
# 可到 4MB/s。wheel 预置到持久目录比让目标机自己下可靠得多。
MODEL_WHEEL_URL_EN=
MODEL_WHEEL_URL_ZH=