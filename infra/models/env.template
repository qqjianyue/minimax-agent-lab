# 嵌入模型配置模板（D1）
#
# 复制为 env 后按机器修改：cp env.template env
# env 不会进版本库；部署时由 deploy/lib/common.sh 的 ensure_component_env
# 结合实际环境自动生成（已存在的手工 env 不被覆盖）。
# 机器定制请写在部署根 config.yaml（${AGENT_HOME}/config.yaml）的
# components.models 下，部署时自动解析覆写本 env —— 不要手工改 env。

# --- 路径 ---
# 应用根目录（integrity/ 位于其下，setup.sh 据此定位完整性凭证目录；
# 与 deploy/ 的 AGENT_HOME 一致）
AGENT_HOME=/data/workspace/minimax-agent
# 模型根目录。必须指向 shared/ 下（跨版本共享，回退不丢），
# 且不能放 /home（独立小分区）。
MODELS_HOME=/data/workspace/minimax-agent/shared/models

# --- 模型 ---
# 已定档：BAAI/bge-base-zh-v1.5（中文，768 维，~400MiB，CPU 性价比最优）
MODEL_NAME=BAAI/bge-base-zh-v1.5
# 固定 commit sha（manifest.yaml 里的唯一事实来源；这里仅作下载默认值，
# 若与 manifest 不一致以 manifest 为准）
MODEL_REVISION=f03589ceff5aac7111bd60cfc7d497ca17ecac65

# --- 网络 ---
# 目标机直连 HF 不可达时，启用镜像（如 https://hf-mirror.com）。
# 留空 = 直连 huggingface.co
HF_ENDPOINT=
